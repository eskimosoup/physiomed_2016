<h1>Practice Application Form Submission</h1>
<h2>Main Details</h2>

<table>
  <tr>
    <th align="left">Name</th>
    <td align="left"><%= practice_application.name %></td>
  </tr>
  <tr>
    <th align="left">Address</th>
    <td align="left"><%= practice_application.address %></td>
  </tr>
  <tr>
    <th align="left">County</th>
    <td align="left"><%= practice_application.county %></td>
  </tr>
  <tr>
    <th align="left">Post Code</th>
    <td align="left"><%= practice_application.postcode %></td>
  </tr>
  <tr>
    <th align="left">Phone</th>
    <td align="left"><%= practice_application.telephone %></td>
  </tr>
  <tr>
    <th align="left">Mobile</th>
    <td align="left"><%= practice_application.mobile_number %></td>
  </tr>
  <tr>
    <th align="left">Fax</th>
    <td align="left"><%= practice_application.fax %></td>
  </tr>
  <tr>
    <th align="left">Email</th>
    <td align="left"><%= practice_application.email %></td>
  </tr>
  <% practice_application.contacts.each do |contact| %>
    <tr>
      <th align="left">Contact Name</th>
      <td align="left"><%= contact.name %></td>
    </tr>
    <tr>
      <th align="left">Contact Position</th>
      <td align="left"><%= contact.position %></td>
    </tr>
  <% end %>

  <tr>
    <th align="left">Other locations (inc Postcode)</th>
    <td align="left"><%= practice_application.other_locations %></td>
  </tr>

  <tr>
    <th align="left">Established</th>
    <td align="left"><%= practice_application.established %></td>
  </tr>
</table>

<h2>Practice Details</h2>

<h3>What are your opening hours?</h3>

<table>
  <tr>
    <th align="left">Monday</th>
    <td align="left"><%= practice_application.monday %></td>
  </tr>
  <tr>
    <th align="left">Tuesday</th>
    <td align="left"><%= practice_application.tuesday %></td>
  </tr>
  <tr>
    <th align="left">Wednesday</th>
    <td align="left"><%= practice_application.wednesday %></td>
  </tr>
  <tr>
    <th align="left">Thursday</th>
    <td align="left"><%= practice_application.thursday %></td>
  </tr>
  <tr>
    <th align="left">Friday</th>
    <td align="left"><%= practice_application.friday %></td>
  </tr>
  <tr>
    <th align="left">Saturday</th>
    <td align="left"><%= practice_application.saturday %></td>
  </tr>
  <tr>
    <th align="left">Sunday</th>
    <td align="left"><%= practice_application.sunday %></td>
  </tr>
</table>

<h3>Treatment Charges</h3>

<table>
  <tr>
    <th align="left">Initial Cost</th>
    <td align="left"><%= practice_application.initial_assessment_cost %></td>
  </tr>
  <tr>
    <th align="left">Initial duration</th>
    <td align="left"><%= practice_application.initial_assessment_duration %></td>
  </tr>
  <tr>
    <th align="left">Subsequent Cost</th>
    <td align="left"><%= practice_application.subsequent_treatment_cost %></td>
  </tr>
  <tr>
    <th align="left">Subsequent Duration</th>
    <td align="left"><%= practice_application.subsequent_treatment_duration %></td>
  </tr>
  <tr>
    <th align="left">History of price increases (date and price increase</th>
    <td align="left"><%= practice_application.price_history %></td>
  </tr>
</table>

<% unless practice_application.practitioners.blank? %>
  <h2>Practitioners</h2>
  <% practice_application.practitioners.each do |practitioner| %>
    <div class="practitioner">
      <table>
        <tr>
          <th align="left">Name</th>
          <td align="left"><%= practitioner.name %></td>
        </tr>
        <tr>
          <th align="left">Gender</th>
          <td align="left"><%= practitioner.gender %></td>
        </tr>
        <tr>
          <th align="left">Qualification Date</th>
          <td align="left"><%= practitioner.qualification_date %></td>
        </tr>
        <tr>
          <th align="left">No. of years MSK experience</th>
          <td align="left"><%= practitioner.years_practicing %></td>
        </tr>
      </table>
    </div>
  <% end %>
<% end %>

<h3>Additional Treatments / Services</h3>


<table>
  <tr>
    <th align="left">Do you offer Acupuncture as part of treatment? </th>
    <td align="left"><%= practice_application.acupuncture_offered %></td>
  </tr>

  <tr>
    <th align="left">Do you offer Women's Health as part of treatment?</th>
    <td align="left"><%= practice_application.womens_health_offered %></td>
  </tr>

  <tr>
    <th align="left">Do you offer Shockwave as part of treatment?</th>
    <td align="left"><%= practice_application.shockwave_offered %></td>
  </tr>

  <tr>
    <th align="left">Are there any other types of treatment you provide?</th>
    <td align="left"><%= practice_application.other_treatments_offered %></td>
  </tr>

  <tr>
    <th align="left">Do you Provide DSE Assessments?</th>
    <td align="left"><%= practice_application.dse_offered %></td>
  </tr>

  <tr>
    <th align="left">Do you Provide Vehicle Assessments?</th>
    <td align="left"><%= practice_application.vehicle_assessments_offered %></td>
  </tr>
</table>

<h3>Additional required information</h3>

<table>
  <tr>
    <th align="left">What % of treatments are manual therapy?</th>
    <td align="left"><%= practice_application.manual_therapy %></td>
  </tr>
  <tr>
    <th align="left">Number of days on average until IA booked?</th>
    <td align="left"><%= practice_application.number_of_days_till_ia_booked %></td>
  </tr>

  <% if false %>
    <tr>
      <th align="left">What % of capacity are you running at?</th>
      <td align="left"><%= practice_application.capacity %></td>
    </tr>
  <% end %>

  <tr>
    <th align="left">Treatment Rooms</th>
    <td align="left"><%= practice_application.treatment_rooms %></td>
  </tr>
  <tr>
    <th align="left">Parking</th>
    <td align="left"><%= practice_application.parking_facilities? ? "Yes" : "No" %></td>
  </tr>
  <tr>
    <th align="left">If not please provide details of the nearest parking facilities.</th>
    <td align="left"><%= practice_application.parking_facilities_information %></td>
  </tr>
  <tr>
    <th align="left">Full time receptionist</th>
    <td align="left"><%= practice_application.receptionist? ? "Yes" : "No" %></td>
  </tr>
  <tr>
    <th align="left">Disabled access</th>
    <td align="left"><%= practice_application.disabled_access? ? "Yes" : "No" %></td>
  </tr>
  <% if false %>
  <tr>
    <th align="left">Do you have TM2 or PPS?</th>
    <td align="left"><%= practice_application.tm2_or_pps %></td>
  </tr>
  <% end %>
  <% if false %>
  <tr>
    <th align="left">Online booking?</th>
    <td align="left"><%= practice_application.online_booking? ? "Yes" : "No" %></td>
  </tr>
  <% end %>
  <% if false %>
  <tr>
    <th align="left">BUPA registered?</th>
    <td align="left"><%= practice_application.bupa_registered? ? "Yes" : "No" %></td>
  </tr>
  <% end %>
  <tr>
    <th align="left">Domiciliary visits?</th>
    <td align="left"><%= practice_application.domiciliary_visits? ? "Yes" : "No" %></td>
  </tr>
  <tr>
    <th align="left">Cancellation Policy</th>
    <td align="left"><%= practice_application.cancellation_policy %></td>
  </tr>
  <tr>
    <th align="left">Public Liability Insurance</th>
    <td align="left"><%= practice_application.public_liability_insurance? ? "Yes" : "No" %></td>
  </tr>
  <tr>
    <th align="left">Public Liability Insurance Expiry Date</th>
    <td align="left"><%= practice_application.public_liability_expiry_date %></td>
  </tr>
  <tr>
    <th align="left">Employee Liability Insurance</th>
    <td align="left"><%= practice_application.employee_liability_insurance? ? "Yes" : "No" %></td>
  </tr>
  <tr>
    <th align="left">Employee Liability Insurance Expiry Date</th>
    <td align="left"><%= practice_application.employee_liability_expiry_date %></td>
  </tr>
  <tr>
    <th align="left">Describe your practice i.e. within gym, GP practice, converted building etc.</th>
    <td align="left"><%= practice_application.description %></td>
  </tr>
</table>
